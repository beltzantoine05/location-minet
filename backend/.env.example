# Copier ce fichier vers backend/.env puis remplir les valeurs (le .env n'est jamais commité)

# Clé de signature des JWT. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Optionnel : base de données (défaut : backend/dev_database.db)
# DATABASE_URL=sqlite:////chemin/absolu/vers/location_minet.db

# Optionnel : origines autorisées par le CORS, séparées par des virgules
# CORS_ORIGINS=http://localhost:5173,https://mon-domaine.fr
